# Адрес бэкенда для запросов из браузера (локально: http://localhost:8000, на сервере вуза: /sqlfront или полный URL)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Префикс пути приложения при развертке за reverse proxy (локально: оставить пустым, на сервере вуза: /sqlfront)
NEXT_PUBLIC_BASE_PATH=
